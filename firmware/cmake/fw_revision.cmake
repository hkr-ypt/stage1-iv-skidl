# fw_revision.cmake — run at every build (cmake -P, target fw_revision):
# writes OUT with the source revision, rewriting it only when the revision
# changed. An incremental build therefore never carries the revision of an
# earlier configure, and an unchanged revision recompiles nothing.
#   -DSRC=<source dir> -DOUT=<generated header>
execute_process(
    COMMAND git -C "${SRC}" describe --always --dirty --abbrev=12
    OUTPUT_VARIABLE rev OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET
    RESULT_VARIABLE res)
if(NOT res EQUAL 0 OR NOT rev)
    set(rev "unknown")
endif()
set(text "/* generated by cmake/fw_revision.cmake: do not edit */\n#define FW_GIT_REV \"${rev}\"\n")
set(old "")
if(EXISTS "${OUT}")
    file(READ "${OUT}" old)
endif()
if(NOT old STREQUAL text)
    file(WRITE "${OUT}" "${text}")
endif()
