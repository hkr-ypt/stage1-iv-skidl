  (add (segment "-15VA" "F.Cu" 0.2 107.25 49.85 99.155 49.85)
       (reason "0.31 mm from U6 pin 5, 0.43 mm from pin 6"))
  (add (segment "-15VA" "F.Cu" 0.2 99.155 49.85 97.945 51.06)
       (reason "into U6 pin 4"))
  (add (via "AGND" 110.53 44.5 0.6 0.3 "F.Cu" "B.Cu")
