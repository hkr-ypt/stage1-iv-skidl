# policy_clearance.eco — bring the routed board to the repository netclass
# clearances (libraries/netclasses.py). Applied last, after
# layout/final_corrections.eco.
#
# The human routing captured in layout/stage1_iv.layout was drawn to 0.20 mm
# everywhere; the policy asks 0.25 mm around the SENSE, FORCE and
# LOCAL_ANALOG nets and 0.30 mm around the +/-15 V rails and the U12 LED
# string. Every run that came closer than its class allows is removed here and
# redrawn between the same terminals: first an automatic pass
# (tools/eco_route.py, which inflates every obstacle by the larger of the two
# classes' clearances), then hand re-routes where that found no path, grouped
# below by area. Widths are unchanged except ADC_XTAL1 past the CS_ADC/DRDY
# vias (0.40 -> 0.25 mm, its class width). One removed run was the only link
# of two F.Cu AGND pour islands to the rest of AGND; four stitch vias replace
# it (last section).
#
# Result, KiCad 10 DRC with zones refilled under stage1_iv.kicad_pro:
# 0 clearance violations and 0 unconnected items. validation/
# routed_board_check.py requires exactly that.
(stage1_iv_eco (version 1) (name "policy_clearance") (base "stage1_iv.layout")
  # --- automatic pass: tools/eco_route.py at the netclass clearance ---
  (remove (segment "/adc/ADC_AIN0" "F.Cu" 0.2 123.84 50.525 124.751661 50.525)
          (reason "re-routed at the netclass clearance"))
  (remove (segment "AGND" "F.Cu" 0.2 115.875 73.237648 116.887352 74.25)
          (reason "re-routed at the netclass clearance"))
  (remove (segment "AGND" "F.Cu" 0.2 115.875 71.85 115.875 73.237648)
          (reason "re-routed at the netclass clearance"))
  (remove (segment "AGND" "F.Cu" 0.2 115.025 71 115.875 71.85)
          (reason "re-routed at the netclass clearance"))
  (remove (segment "AGND" "F.Cu" 0.2 116.887352 74.25 120.25 74.25)
          (reason "re-routed at the netclass clearance"))
  (remove (segment "AGND" "F.Cu" 0.2 122.475 69.275 123.9375 69.275)
          (reason "re-routed at the netclass clearance"))
  (remove (segment "/output_buffer/OPA548_ILIM" "F.Cu" 0.2 91.8625 61.597244 94.015256 63.75)
          (reason "re-routed at the netclass clearance"))
  (remove (segment "/output_buffer/OPA548_ILIM" "F.Cu" 0.2 91.8625 60 91.8625 61.597244)
          (reason "re-routed at the netclass clearance"))
