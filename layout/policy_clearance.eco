          (reason "re-routed at the netclass clearance"))
  (remove (segment "/dac_sweep/VREF_HALF_RAW" "F.Cu" 0.2 113.801304 72.75 110.075 69.023696)
          (reason "re-routed at the netclass clearance"))
  (remove (segment "/dac_sweep/VREF_HALF_RAW" "F.Cu" 0.2 114.925 72.75 113.801304 72.75)
          (reason "re-routed at the netclass clearance"))
  (remove (segment "/dac_sweep/VREF_HALF_RAW" "F.Cu" 0.2 110.075 69.023696 110.075 67.25)
          (reason "re-routed at the netclass clearance"))
  (remove (segment "/dac_sweep/VREF_HALF_RAW" "F.Cu" 0.2 110.075 67.25 110.575 66.75)
