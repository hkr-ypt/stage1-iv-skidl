  (add (segment "AGND" "F.Cu" 0.2 110.53 44.5 110.25 44.5)
       (reason "C20 pad 2 to its stitch via"))
  # --- +15VA: the U5/U7 group's link to J1 ---
  (remove (segment "+15VA" "B.Cu" 0.2 102.555 67.45 102.755 67.25)
          (reason "the squeeze path is replaced by the link via C17"))
  (remove (segment "+15VA" "B.Cu" 0.2 102.755 67.25 103.5 67.25)
          (reason "0.68 mm gap between R8 pad 1 and U5 pin 6; replaced"))
  (remove (segment "+15VA" "B.Cu" 0.2 103.5 67.25 104.45 66.3)
          (reason "0.68 mm gap between R8 pad 1 and U5 pin 6; replaced"))
  (remove (segment "+15VA" "B.Cu" 0.2 104.45 66.3 104.45 65.012352)
          (reason "0.68 mm gap between R8 pad 1 and U5 pin 6; replaced"))
  (remove (segment "+15VA" "B.Cu" 0.2 104.45 65.012352 106.712352 62.75)
          (reason "0.68 mm gap between R8 pad 1 and U5 pin 6; replaced"))
  (remove (segment "+15VA" "B.Cu" 0.2 106.712352 62.75 109 62.75)
